#!/usr/bin/env bash
# scontrol, replaying the example cluster's partition dumps.
#
#   scontrol show partition            -> every dump the account can see
#   scontrol show partition <name>     -> that dump, or slurm's own not-found
#                                         error on stderr with exit 1
# A partition with no dump file is one this account cannot see — which is
# exactly what joint_hidden is in the example. Lines beginning with `#` (each
# file's example marker) are not replayed.
set -euo pipefail
FIELD="${ODIN_STUB_FIELD:?ODIN_STUB_FIELD must point at the example cluster dir}"

if [ "${1:-}" != "show" ] || [ "${2:-}" != "partition" ]; then
    echo "stub scontrol: only 'show partition [name]' is replayed" >&2
    exit 64
fi

name="${3:-}"
if [ -z "${name}" ]; then
    cat "${FIELD}"/scontrol_*.txt 2>/dev/null | grep -v -e '^scontrol: error' -e '^#' || true
    exit 0
fi

dump="${FIELD}/scontrol_${name}.txt"
if [ ! -f "${dump}" ]; then
    grep -v '^#' "${FIELD}/scontrol_missing.txt" | sed "s/PARTITION/${name}/" >&2
    exit 1
fi
grep -v '^#' "${dump}"
