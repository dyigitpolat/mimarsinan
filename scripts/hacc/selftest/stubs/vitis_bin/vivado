#!/usr/bin/env bash
# vivado, standing in for the real thing: build_xclbn.sh packages the RTL
# kernel by generating pack_kernel.tcl and running `vivado -mode batch
# -source <tcl>`. This stub parses that Tcl for the `set xo_path "..."` line
# the generator writes, creates the .xo, and checks nothing else. Its only
# job is to let odin_build.sbatch run to the end off-cluster so the SMOKE
# branch can be gated.
set -euo pipefail
tcl=""
while [ $# -gt 0 ]; do
    case "$1" in
        -source) tcl="${2:-}"; shift ;;
    esac
    shift
done
[ -n "${tcl}" ] && [ -f "${tcl}" ] || { echo "stub vivado: no -source tcl" >&2; exit 2; }
out="$(sed -n 's/^set xo_path "\(.*\)"$/\1/p' "${tcl}" | head -n 1)"
[ -n "${out}" ] || { echo "stub vivado: no xo_path in ${tcl}" >&2; exit 2; }
mkdir -p "$(dirname "${out}")"
printf 'stub xo\n' > "${out}"
echo "[stub vivado] packaged ${out} from ${tcl}"
