//
// "odin_gen_kernel.v" - the VARIANT fabric: P GENERATED cores, one AER bridge
// each, and the SAME on-fabric sequencer discipline the stock kernel runs, with
// the SAME module name and the SAME port list, so the Vitis wrapper
// `hw/fpga/kernel/odin_fpga_kernel_top.v` binds either one WITHOUT AN EDIT.
//
//   GENERATED FILE -- do not edit. `mapping/export/odin_gen/fabric.py` expands
//   this template from the same `CoreSpec` that expands `odin_gen_core.v.tmpl`,
//   so the fabric's address widths can never drift from the core's.
//
// WHY A SECOND KERNEL FILE AND NOT A PARAMETER. The stock kernel
// (`hw/fpga/kernel/odin_fpga_kernel.v`) is the RTL a routed U55C bitstream was
// built from, and the chip cache keys that bitstream on a digest over the
// vendored + kernel source sets (`make_package.rtl_digest`). A `CORE_KIND`
// generate branch inside that file would move the digest and orphan the routed
// artifact for a branch it never elaborates. So the chip configuration selects
// a SOURCE SET instead of a parameter: the stock config compiles the file in
// `hw/fpga/kernel/`, the wide config compiles THIS one, and the two are never
// compiled together (they declare the same module). Everything above the core
// domain -- the AXI4 wrapper, the register map, `kernel.xml`, the host driver's
// protocol table -- is shared and untouched.
//
// WHAT DIFFERS FROM THE STOCK KERNEL, and nothing else does:
//   * THE CORE. `odin_gen_core` rather than the vendored `ODIN`, so there is no
//     SPI master: the generator's statement of changes replaces the 20-bit SPI
//     slave with a direct synchronous configuration port, one address/data pair
//     per clock.
//   * THE PROGRAMMING OPCODE. `OP_PROG (core, sel, addr, data)` drives that
//     port; `OP_SPI_W` / `OP_SPI_R` / `OP_SHADOW` have no implementation here
//     and are REFUSED by raising `err`, exactly as the stock kernel refuses
//     `OP_PROG`. The encoding itself is unchanged -- it is the third copy of
//     `mimarsinan.chip_simulation.odin_rtl.stimulus`, the same table
//     `hw/tb/tb_odin_gen_core.v` executes.
//   * THE AER-IN WIDTH. AW+1 bits (the low AW name the axon row, bit AW is the
//     all-neurons time reference) rather than the stock link's 2*M+1.
//   * TWO EXTRA REFUSALS the generated core can report and the vendored one
//     cannot: a core whose self-declared spec disagrees with the fabric this
//     template was expanded for (SPEC), and a sticky membrane rail on a law
//     whose contract says the rails are unreachable (RAIL_TOUCHED).
//
// DETERMINISM IS THE CONTRACT, unchanged. Core time is ENABLED cycles: when the
// sequencer wants a word the FIFO cannot yet give it, `core_en` drops and the
// whole core domain stands still for that cycle, so execution is bit-exact
// under ANY stream arrival pattern. `hw/tb/tb_odin_fpga_kernel_axi.v` injects
// seeded starvation against this fabric too.
//
// Capture layout, mirrored in `chip_simulation/odin_fpga/kernel_registers.py`:
//   word 0            : events SEEN (may EXCEED the record capacity)
//   word 1            : the ENABLED-cycle count when the program ended
//   words 2 + 4*i ... : {tag, cycle, core, neuron} per captured event

`timescale 1ns/1ps

module odin_fpga_kernel #(
    parameter NC         = 1,      // generated cores instantiated
    parameter N          = @NEURONS@,  // neurons per core (this variant)
    parameter M          = @NW@,       // neuron-address width (this variant)
    parameter FIFO_WORDS = 1024,
    parameter CAP_WORDS  = 16384   // capture RAM depth, in 32-bit words
) (
    input  wire        clk,
    input  wire        rst,

    input  wire        ap_start,
    output reg         ap_done,
    output reg         ap_idle,
    output reg         ap_ready,
    output wire        err,

    input  wire        str_valid,
    input  wire [31:0] str_data,
    output wire [31:0] str_space,

    input  wire [31:0] cap_raddr,
    output reg  [31:0] cap_rdata
);

    localparam [31:0] OP_END    = 32'd0;
    localparam [31:0] OP_SPI_W  = 32'd1;
    localparam [31:0] OP_SPI_R  = 32'd2;
    localparam [31:0] OP_AER    = 32'd3;
    localparam [31:0] OP_WAIT   = 32'd4;
    localparam [31:0] OP_TAG    = 32'd5;
    localparam [31:0] OP_PROG   = 32'd7;

    localparam [31:0] CAP_HEADER = 32'd2;
    localparam FIFO_AW  = $clog2(FIFO_WORDS);
    localparam CAP_AW   = $clog2(CAP_WORDS);

    localparam AXONS    = @AXONS@;
    localparam NEURONS  = @NEURONS@;
    localparam AW       = @AW@;             // clog2(AXONS)
    localparam NW       = @NW@;             // clog2(NEURONS)
    localparam MBITS    = @MBITS@;
    localparam WBITS    = @WBITS@;
    localparam [31:0] SPEC_FLAGS_EXPECTED = @FLAGS@;
    localparam AER_BITS = AW + 1;

    localparam [FIFO_AW:0] FIFO_DEPTH = FIFO_WORDS;

    // The FIFO's pointers wrap on their own width, so a depth that is not a
    // power of two would silently address a hole; fail at elaboration instead.
    generate
        if ((1 << FIFO_AW) != FIFO_WORDS) begin : g_fifo_depth
            unsupported_FIFO_WORDS_use_a_power_of_two guard_inst();
        end
        // The wrapper above is FROZEN and passes its own N/M down. A variant
        // whose neuron geometry differs from the wrapper's would silently
        // truncate the AER-out address, so it must not elaborate at all.
        if (N != NEURONS) begin : g_neurons
            wrapper_N_disagrees_with_the_generated_core guard_inst();
        end
        if (M != NW) begin : g_addr_width
            wrapper_M_disagrees_with_the_generated_core guard_inst();
        end
    endgenerate

    localparam S_IDLE  = 3'd0;
    localparam S_FETCH = 3'd1;
    localparam S_ARG   = 3'd2;
    localparam S_PROG  = 3'd3;
    localparam S_AER   = 3'd4;
    localparam S_WAIT  = 3'd5;
    localparam S_DONE  = 3'd6;

    reg [2:0]  state;
    reg [2:0]  argc, argi;
    reg        err_r;
    reg [31:0] op, arg0, arg1, arg2, arg3;
    reg [31:0] tag, cycle, events_seen, cap_ptr, wait_left;

    reg        aer_start, issued, saw_busy;
    reg        prog_en_r;
    reg [1:0]  prog_sel_r;
    reg [31:0] prog_addr_r, prog_data_r;
    reg [31:0] active_core;
    reg [AER_BITS-1:0] aer_word;

    wire [NC-1:0]    aer_busy_w, aer_timeout_w, aerout_req_w, rail_w, spec_bad_w;
    wire [NW*NC-1:0] aerout_addr_w;
    reg  [NC-1:0]    aerout_ack_r;

    integer i;
    genvar c;

    wire run_start = (state == S_IDLE) && ap_start;

    //----------------------------------------------------------------------
    //  The elastic op-stream FIFO (identical to the stock kernel's)
    //----------------------------------------------------------------------

    (* ram_style = "block" *) reg [31:0] fifo_ram [0:FIFO_WORDS-1];
    (* ram_style = "block" *) reg [31:0] cap_ram  [0:CAP_WORDS-1];

    reg [FIFO_AW-1:0] wr_ptr, rd_ptr;
    reg [FIFO_AW:0]   fifo_fill;
    reg [31:0]        ram_q;
    reg               ram_q_v;
    reg               fifo_ovf;

    wire        pop_valid  = ram_q_v;
    wire [31:0] str_head   = ram_q;
    wire        fifo_ne    = (fifo_fill != {(FIFO_AW+1){1'b0}});
    wire        fifo_room  = (fifo_fill != FIFO_DEPTH);
    wire        push       = str_valid;
    wire        pop_fire;
    wire        lift       = fifo_ne && (!ram_q_v || pop_fire);

    assign str_space = FIFO_DEPTH - fifo_fill;

    always @(posedge clk) begin
        if (push) fifo_ram[wr_ptr] <= str_data;
        if (lift) ram_q <= fifo_ram[rd_ptr];
    end

    always @(posedge clk) begin
        if (rst || run_start) begin
            wr_ptr    <= {FIFO_AW{1'b0}};
            rd_ptr    <= {FIFO_AW{1'b0}};
            fifo_fill <= {(FIFO_AW+1){1'b0}};
            ram_q_v   <= 1'b0;
            fifo_ovf  <= 1'b0;
        end else begin
            if (push) wr_ptr <= wr_ptr + 1'b1;
            if (lift) rd_ptr <= rd_ptr + 1'b1;
            case ({push, lift})
                2'b10:   fifo_fill <= fifo_fill + 1'b1;
                2'b01:   fifo_fill <= fifo_fill - 1'b1;
                default: ;
            endcase
            if (lift)          ram_q_v <= 1'b1;
            else if (pop_fire) ram_q_v <= 1'b0;
            if (push && !fifo_room) fifo_ovf <= 1'b1;
        end
    end

    //----------------------------------------------------------------------
    //  Core-enable gating: core time is ENABLED cycles
    //----------------------------------------------------------------------

    wire seq_fetching = (state == S_FETCH) || (state == S_ARG);
    wire core_en      = rst || !(seq_fetching && !pop_valid);

    assign pop_fire = seq_fetching && pop_valid;

    reg core_en_q;
    always @(negedge clk) core_en_q <= core_en;
    wire core_clk = clk & (core_en_q | rst);

    always @(posedge clk)
        if (rst || run_start) cycle <= 32'd0;
        else if (core_en)     cycle <= cycle + 32'd1;

    //----------------------------------------------------------------------
    //  The generated cores and their AER-in bridges
    //----------------------------------------------------------------------

    generate
        for (c = 0; c < NC; c = c + 1) begin : core_gen
            wire sel = (active_core == c);
            wire aerin_req_w, aerin_ack_w;
            wire [AER_BITS-1:0] aerin_addr_w;
            wire [31:0] spec_axons_w, spec_neurons_w;
            wire [31:0] spec_mbits_w, spec_wbits_w, spec_flags_w;

            odin_aer_bridge #(.ADDR_BITS(AER_BITS)) aer_i (
                .clk (core_clk), .rst (rst), .start (aer_start && sel),
                .addr (aer_word), .aer_ack (aerin_ack_w),
                .aer_req (aerin_req_w), .aer_addr (aerin_addr_w),
                .busy (aer_busy_w[c]), .timeout (aer_timeout_w[c])
            );

            odin_gen_core dut (
                .CLK          (core_clk),
                .RST          (rst),
                .PROG_EN      (prog_en_r && sel),
                .PROG_SEL     (prog_sel_r),
                .PROG_ADDR    (prog_addr_r),
                .PROG_DATA    (prog_data_r),
                .AERIN_ADDR   (aerin_addr_w),
                .AERIN_REQ    (aerin_req_w),
                .AERIN_ACK    (aerin_ack_w),
                .AEROUT_ADDR  (aerout_addr_w[NW*c+NW-1:NW*c]),
                .AEROUT_REQ   (aerout_req_w[c]),
                .AEROUT_ACK   (aerout_ack_r[c]),
                .SPEC_AXONS   (spec_axons_w),
                .SPEC_NEURONS (spec_neurons_w),
                .SPEC_MBITS   (spec_mbits_w),
                .SPEC_WBITS   (spec_wbits_w),
                .SPEC_FLAGS   (spec_flags_w),
                .RAIL_TOUCHED (rail_w[c])
            );

            // The core declares its own geometry and law on constant outputs;
            // a fabric expanded from a different spec than the core file must
            // REFUSE the run rather than truncate an address silently.
            assign spec_bad_w[c] = (spec_axons_w   != AXONS)
                                 | (spec_neurons_w != NEURONS)
                                 | (spec_mbits_w   != MBITS)
                                 | (spec_wbits_w   != WBITS)
                                 | (spec_flags_w   != SPEC_FLAGS_EXPECTED);
        end
    endgenerate

    //----------------------------------------------------------------------
    //  Capture engine (identical to the stock kernel's)
    //----------------------------------------------------------------------

    reg [1:0]  cap_state;
    reg [31:0] cap_core;
    reg        cap_active, cap_space;
    reg [1:0]  hdr_written;

    reg  run_ended;

    wire [31:0] cap_word =
          (cap_state == 2'd0) ? tag
        : (cap_state == 2'd1) ? cycle
        : (cap_state == 2'd2) ? cap_core
        : {{(32-NW){1'b0}}, aerout_addr_w[NW*cap_core[7:0] +: NW]};

    wire        hdr_we    = run_ended && !cap_active && (hdr_written != 2'd2);
    wire        cap_we    = (cap_active && cap_space) || hdr_we;
    wire [31:0] cap_waddr = cap_active ? cap_ptr : {31'd0, hdr_written[0]};
    wire [31:0] cap_wdata = cap_active ? cap_word
                          : (hdr_written[0] ? cycle : events_seen);

    always @(posedge clk)
        cap_rdata <= cap_ram[cap_raddr[CAP_AW-1:0]];

    always @(posedge clk)
        if (core_en && cap_we) cap_ram[cap_waddr[CAP_AW-1:0]] <= cap_wdata;

    always @(posedge clk) begin : capture
        reg found;
        if (rst || run_start) begin
            cap_state    <= 2'd0;
            cap_core     <= 32'd0;
            cap_active   <= 1'b0;
            cap_space    <= 1'b0;
            cap_ptr      <= CAP_HEADER;
            events_seen  <= 32'd0;
            hdr_written  <= 2'd0;
            aerout_ack_r <= {NC{1'b0}};
        end else if (core_en) begin
            if (!cap_active) begin
                found = 1'b0;
                for (i = 0; i < NC; i = i + 1) begin
                    if (!found && aerout_req_w[i] && !aerout_ack_r[i]) begin
                        found      = 1'b1;
                        cap_core   <= i[31:0];
                        cap_active <= 1'b1;
                        cap_state  <= 2'd0;
                        cap_space  <= (cap_ptr + 32'd4) <= CAP_WORDS;
                    end
                    if (aerout_ack_r[i] && !aerout_req_w[i]) aerout_ack_r[i] <= 1'b0;
                end
                if (hdr_we) hdr_written <= hdr_written + 2'd1;
            end else begin
                if (cap_space) cap_ptr <= cap_ptr + 32'd1;
                cap_state <= cap_state + 2'd1;
                if (cap_state == 2'd3) begin
                    events_seen                 <= events_seen + 32'd1;
                    aerout_ack_r[cap_core[7:0]] <= 1'b1;
                    cap_active                  <= 1'b0;
                end
            end
        end
    end

    //----------------------------------------------------------------------
    //  The sequencer: the same token program, one programming form apart
    //----------------------------------------------------------------------

    // A rail on a law that declares the rails unreachable, and a core whose own
    // spec disagrees with this fabric, are BOTH run-invalidating: they reach the
    // host the only way a refusal can, through `err`.
    assign err = err_r | fifo_ovf | (|rail_w) | (|spec_bad_w);

    always @(posedge clk) begin
        if (rst) begin
            state <= S_IDLE; tag <= 32'd0; wait_left <= 32'd0;
            ap_done <= 1'b0; ap_idle <= 1'b1; ap_ready <= 1'b0; err_r <= 1'b0;
            aer_start <= 1'b0; active_core <= 32'd0;
            prog_en_r <= 1'b0; prog_sel_r <= 2'd0;
            prog_addr_r <= 32'd0; prog_data_r <= 32'd0;
            argc <= 3'd0; argi <= 3'd0;
            issued <= 1'b0; saw_busy <= 1'b0; run_ended <= 1'b0;
        end else if (core_en) begin
            aer_start <= 1'b0;
            prog_en_r <= 1'b0;
            ap_ready  <= 1'b0;
            case (state)
                S_IDLE: begin
                    ap_idle <= 1'b1;
                    if (ap_start) begin
                        ap_done <= 1'b0; ap_idle <= 1'b0;
                        err_r <= 1'b0; run_ended <= 1'b0; state <= S_FETCH;
                    end
                end
                S_FETCH: begin
                    op     <= str_head;
                    argi   <= 3'd0;
                    issued <= 1'b0;
                    case (str_head)
                        OP_END:   state <= S_DONE;
                        OP_PROG:  begin argc <= 3'd4; state <= S_ARG; end
                        OP_AER:   begin argc <= 3'd2; state <= S_ARG; end
                        OP_WAIT:  begin argc <= 3'd1; state <= S_ARG; end
                        OP_TAG:   begin argc <= 3'd1; state <= S_ARG; end
                        // The generated core has no SPI slave to drive, and no
                        // register has a readback path, so SPI_W / SPI_R /
                        // SHADOW / anything unknown is REFUSED rather than run
                        // as a different program than the host built.
                        OP_SPI_W, OP_SPI_R: begin
                            err_r <= 1'b1;
                            state <= S_DONE;
                        end
                        default: begin
                            err_r <= 1'b1;
                            state <= S_DONE;
                        end
                    endcase
                end
                S_ARG: begin
                    case (argi)
                        3'd0: begin
                            arg0 <= str_head;
                            if (op == OP_TAG) tag <= str_head;
                        end
                        3'd1:    arg1 <= str_head;
                        3'd2:    arg2 <= str_head;
                        default: arg3 <= str_head;
                    endcase
                    if (argi + 3'd1 == argc) begin
                        case (op)
                            OP_PROG: state <= S_PROG;
                            OP_AER:  state <= S_AER;
                            OP_WAIT: state <= S_WAIT;
                            default: state <= S_FETCH;
                        endcase
                    end else begin
                        argi <= argi + 3'd1;
                    end
                end
                S_PROG: begin
                    // One clock on the configuration port, which is what the
                    // generator's statement of changes bought by replacing the
                    // 40-SCK SPI transaction. `core_en` is high in this state,
                    // so the gated core clock ticks exactly once while
                    // `prog_en_r` is asserted.
                    if (!issued) begin
                        active_core <= arg0;
                        prog_sel_r  <= arg1[1:0];
                        prog_addr_r <= arg2;
                        prog_data_r <= arg3;
                        issued      <= 1'b1;
                    end else begin
                        prog_en_r <= 1'b1;
                        state     <= S_FETCH;
                    end
                end
                S_AER: begin
                    if (!issued) begin
                        active_core <= arg0;
                        aer_word    <= arg1[AER_BITS-1:0];
                        aer_start   <= 1'b1;
                        issued      <= 1'b1;
                        saw_busy    <= 1'b0;
                    end else if (!saw_busy) begin
                        if (aer_busy_w[active_core[7:0]]) saw_busy <= 1'b1;
                    end else if (!aer_busy_w[active_core[7:0]]) begin
                        state <= S_FETCH;
                    end
                end
                S_WAIT: begin
                    if (!issued) begin
                        wait_left <= arg0;
                        issued    <= 1'b1;
                        if (arg0 == 32'd0) state <= S_FETCH;
                    end else if (wait_left <= 32'd1) begin
                        wait_left <= 32'd0;
                        state     <= S_FETCH;
                    end else begin
                        wait_left <= wait_left - 32'd1;
                    end
                end
                default: begin
                    run_ended <= 1'b1;
                    if (|aer_timeout_w) err_r <= 1'b1;
                    ap_done  <= 1'b1;
                    ap_ready <= 1'b1;
                    ap_idle  <= 1'b1;
                    if (!ap_start) state <= S_IDLE;
                end
            endcase
        end
    end

endmodule
